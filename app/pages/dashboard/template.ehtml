import "./style.css";
import type { Listener } from "@elements/app";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import { AppHeader } from "#app/shared/templates/layout/template";
import { ForecastStats } from "#app/shared/templates/stats/template";
import { money, moneyShort, percent, quarterLabel, whenLabel } from "#app/shared/format";
import type { ForecastChange, RepNumbers } from "#app/shared/services/forecast";
import { Card, CardHeader, CardTitle, CardDescription, CardContent } from "@elements/ui/card";
import { Table, TableHead, TableCell } from "@elements/ui/table";
import { Badge } from "@elements/ui/badge";
import { NativeSelect } from "@elements/ui/native-select";
import { LineChart } from "@elements/ui/chart-line";
import { BarChart } from "@elements/ui/chart-bar";
import { Toaster, toast } from "@elements/ui/toast";
import { fetchDashboard, Dashboard } from "./services";
import {
  ATTAINMENT_CONFIG, TREND_CONFIG, CATEGORY_CONFIG, SERIES, moneyAxis, legend, tooltip,
  attainmentRows, trendRows, categoryRows,
} from "./charts";

interface LiveState {
  repId: string;
  at: number;
}

interface DashState {
  data: Dashboard;
  quarter: string;
  live: LiveState;
}

type GapVariant = "outline" | "success" | "warning" | "danger" | "info";

interface Gap {
  text: string;
  variant: GapVariant;
}

const CHANGE_TEXT: Record<ForecastChange["kind"], string> = {
  deal: "updated a deal",
  call: "submitted a call",
  quota: "quota changed",
  stage: "stage probabilities changed",
  snapshot: "weekly snapshot taken",
};

function refresh(state: DashState) {
  state.data = fetchDashboard(state.quarter);
}

function onChange(state: DashState, change: ForecastChange) {
  refresh(state);

  let rep = state.data.reps.find((r) => r.repId === change.repId);
  let who = rep ? `${rep.name} ` : "";
  let at = Date.now();

  state.live = { repId: change.repId, at };
  toast(`${who}${CHANGE_TEXT[change.kind]}`, { description: whenLabel(new Date(at)) });

  setTimeout(() => {
    if (state.live.at === at) {
      state.live.repId = "";
    }
  }, 2500);
}

function onQuarterChange(state: DashState) {
  refresh(state);
}

/**
 * Call minus what the deals add up to. Over means the rep is calling more
 * than their deals support; under means they may be holding back.
 */
function gapFor(call: number | null, deals: number): Gap {
  if (call === null) {
    return { text: "no call", variant: "outline" };
  }

  let gap = call - deals;
  let share = deals ? Math.abs(gap) / deals : 1;

  if (share < 0.03) {
    return { text: "aligned", variant: "success" };
  }

  if (gap > 0) {
    return { text: `${moneyShort(gap)} over`, variant: share >= 0.1 ? "danger" : "warning" };
  }

  return { text: `${moneyShort(-gap)} under`, variant: "info" };
}

function dealsCommit(r: RepNumbers): number {
  return r.closed + r.commit;
}

function dealsBestCase(r: RepNumbers): number {
  return r.closed + r.commit + r.bestCase;
}

<html lang="en" class="page-dashboard" (
  name: string,
  initial: Dashboard,
  changes: Listener<ForecastChange>,
  private state: DashState = { data: initial, quarter: initial.quarter, live: { repId: "", at: 0 } },
) oninit={() => changes.on("notify", (change) => onChange(state, change))}>
  <head>
    <title>Dashboard · commitvane</title>
    <meta name="description" content="Team forecast for the quarter">
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <AppHeader {name} role="manager" current="dashboard" />
    <Toaster />

    <main class="dashboard-main page-shell is-wide stack is-xl">
      <div class="forecast-head row">
        <div class="stack is-xs">
          <h1>Team forecast</h1>
          <p class="live-note">{state.data.team.calledThisWeek} of {state.data.reps.length} reps have called this week</p>
        </div>

        <div class="dashboard-controls row">
          <Badge variant="success" dot>Live</Badge>
          <NativeSelect value={state.quarter}
                        attrs={{ "aria-label": "Quarter" }}
                        options={state.data.quarters.map((q) => ({ value: q, label: quarterLabel(q) }))}
                        onchange={() => onQuarterChange(state)} />
        </div>
      </div>

      <ForecastStats numbers={state.data.team} />

      <div class="charts">
        <Card>
          <CardHeader>
            <CardTitle level={2}>Closed won against quota</CardTitle>
            <CardDescription>Cumulative by week, team quota {moneyShort(state.data.team.quota)}</CardDescription>
          </CardHeader>
          <CardContent>
            <LineChart class="chart-frame"
                       data={attainmentRows(state.data)}
                       config={ATTAINMENT_CONFIG}
                       x="week"
                       curve="monotone"
                       dots
                       valueAxis={moneyAxis}
                       {legend}
                       {tooltip}
                       label="Cumulative closed won by week against team quota" />
          </CardContent>
        </Card>

        <Card>
          <CardHeader>
            <CardTitle level={2}>Team commit, week over week</CardTitle>
            <CardDescription>Monday snapshots, then right now</CardDescription>
          </CardHeader>
          <CardContent>
            <LineChart class="chart-frame"
                       data={trendRows(state.data)}
                       config={TREND_CONFIG}
                       x="week"
                       curve="monotone"
                       dots
                       connectNulls
                       valueAxis={{ ...moneyAxis, domain: ["dataMin", "auto"] }}
                       {legend}
                       {tooltip}
                       label="Team commit from deals and from calls by week" />
          </CardContent>
        </Card>

        <Card class="is-wide">
          <CardHeader>
            <CardTitle level={2}>Forecast by category, per rep</CardTitle>
            <CardDescription>Stacked from most to least certain; the tick marks each rep's quota</CardDescription>
          </CardHeader>
          <CardContent>
            <BarChart class="chart-frame is-tall"
                      data={categoryRows(state.data)}
                      config={CATEGORY_CONFIG}
                      x="rep"
                      series={SERIES}
                      stack="normal"
                      targets="quota"
                      maxBarSize={48}
                      valueAxis={moneyAxis}
                      {legend}
                      {tooltip}
                      label="Each rep's closed, commit, best case and pipeline against quota" />
          </CardContent>
        </Card>
      </div>

      <Card>
        <CardHeader>
          <CardTitle level={2}>Calls against deals</CardTitle>
          <CardDescription>Each rep's latest call next to what their deals add up to</CardDescription>
        </CardHeader>
        <CardContent class="stack">
          <Table label="Calls against deals">
            <table class="dash-table">
              <thead>
                <tr>
                  <TableHead>Rep</TableHead>
                  <TableHead align="end">Called commit</TableHead>
                  <TableHead align="end">Deals: closed + commit</TableHead>
                  <TableHead align="end">Gap</TableHead>
                  <TableHead align="end">Called best case</TableHead>
                  <TableHead align="end">Deals: + best case</TableHead>
                  <TableHead align="end">Gap</TableHead>
                  <TableHead>Called</TableHead>
                </tr>
              </thead>
              <tbody>
                <tr e:for={r of state.data.reps.map((r) => ({ ...r, id: r.repId }))}
                    class={[state.live.repId === r.repId && "is-changed"]}>
                  <TableCell class="rep-name">{r.name}</TableCell>
                  <TableCell align="end">{r.callCommit === null ? "–" : money(r.callCommit)}</TableCell>
                  <TableCell align="end">{money(dealsCommit(r))}</TableCell>
                  <TableCell align="end"><Badge variant={gapFor(r.callCommit, dealsCommit(r)).variant}>{gapFor(r.callCommit, dealsCommit(r)).text}</Badge></TableCell>
                  <TableCell align="end">{r.callBestCase === null ? "–" : money(r.callBestCase)}</TableCell>
                  <TableCell align="end">{money(dealsBestCase(r))}</TableCell>
                  <TableCell align="end"><Badge variant={gapFor(r.callBestCase, dealsBestCase(r)).variant}>{gapFor(r.callBestCase, dealsBestCase(r)).text}</Badge></TableCell>
                  <TableCell class="called-at">
                    <span e:if={!r.calledAt}>not yet</span>
                    <span e:elseif={r.calledThisWeek}>{whenLabel(r.calledAt!)}</span>
                    <Badge e:else variant="warning">last call {whenLabel(r.calledAt!)}</Badge>
                  </TableCell>
                </tr>
              </tbody>
              <tfoot>
                <tr>
                  <TableCell>Team</TableCell>
                  <TableCell align="end">{money(state.data.team.callCommit)}</TableCell>
                  <TableCell align="end">{money(state.data.team.closed + state.data.team.commit)}</TableCell>
                  <TableCell></TableCell>
                  <TableCell align="end">{money(state.data.team.callBestCase)}</TableCell>
                  <TableCell align="end">{money(state.data.team.closed + state.data.team.commit + state.data.team.bestCase)}</TableCell>
                  <TableCell></TableCell>
                  <TableCell></TableCell>
                </tr>
              </tfoot>
            </table>
          </Table>
          <p class="table-note">Over by 10% or more is red: the call leans on deals that aren't in commit. Blue means the deals support more than the rep called.</p>
        </CardContent>
      </Card>

      <Card>
        <CardHeader>
          <CardTitle level={2}>By rep</CardTitle>
          <CardDescription>Weighted is amount × stage probability; closed counts in full</CardDescription>
        </CardHeader>
        <CardContent>
          <Table label="By rep">
            <table class="dash-table">
              <thead>
                <tr>
                  <TableHead>Rep</TableHead>
                  <TableHead align="end">Quota</TableHead>
                  <TableHead align="end">Closed won</TableHead>
                  <TableHead align="end">Attainment</TableHead>
                  <TableHead align="end">Commit</TableHead>
                  <TableHead align="end">Best case</TableHead>
                  <TableHead align="end">Pipeline</TableHead>
                  <TableHead align="end">Weighted</TableHead>
                </tr>
              </thead>
              <tbody>
                <tr e:for={r of state.data.reps.map((r) => ({ ...r, id: r.repId }))}
                    class={[state.live.repId === r.repId && "is-changed"]}>
                  <TableCell class="rep-name">{r.name}</TableCell>
                  <TableCell align="end">{money(r.quota)}</TableCell>
                  <TableCell align="end">{money(r.closed)}</TableCell>
                  <TableCell align="end">{percent(r.closed, r.quota)}</TableCell>
                  <TableCell align="end">{money(r.commit)}</TableCell>
                  <TableCell align="end">{money(r.bestCase)}</TableCell>
                  <TableCell align="end">{money(r.pipeline)}</TableCell>
                  <TableCell align="end">{money(r.weighted)}</TableCell>
                </tr>
              </tbody>
              <tfoot>
                <tr>
                  <TableCell>Team</TableCell>
                  <TableCell align="end">{money(state.data.team.quota)}</TableCell>
                  <TableCell align="end">{money(state.data.team.closed)}</TableCell>
                  <TableCell align="end">{percent(state.data.team.closed, state.data.team.quota)}</TableCell>
                  <TableCell align="end">{money(state.data.team.commit)}</TableCell>
                  <TableCell align="end">{money(state.data.team.bestCase)}</TableCell>
                  <TableCell align="end">{money(state.data.team.pipeline)}</TableCell>
                  <TableCell align="end">{money(state.data.team.weighted)}</TableCell>
                </tr>
              </tfoot>
            </table>
          </Table>
        </CardContent>
      </Card>
    </main>
  </body>
</html>
