import "./style.css";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import { AppHeader } from "#app/shared/templates/layout/template";
import { ForecastStats } from "#app/shared/templates/stats/template";
import { CATEGORIES, CATEGORY_LABELS, money, quarterLabel, dayLabel, whenLabel, todayISO } from "#app/shared/format";
import { Card, CardHeader, CardTitle, CardDescription, CardContent } from "@elements/ui/card";
import { Table, TableHead, TableCell } from "@elements/ui/table";
import { NumberInput } from "@elements/ui/number-input";
import { DatePicker } from "@elements/ui/date-picker";
import { NativeSelect } from "@elements/ui/native-select";
import { Field } from "@elements/ui/field";
import { Button } from "@elements/ui/button";
import { Alert } from "@elements/ui/alert";
import { Empty } from "@elements/ui/empty";
import { Toaster, toast } from "@elements/ui/toast";
import { updateDeal, submitCall, RepForecast, Deal, CallForm } from "./services";

interface DealRow extends Deal {
  saving?: boolean;
  error?: string;
}

interface CallState extends CallForm {
  error: string;
  done: boolean;
  busy: boolean;
}

const CATEGORY_OPTIONS = CATEGORIES.map((c) => ({ value: c, label: CATEGORY_LABELS[c] }));

function callDefaults(f: RepForecast): CallState {
  let n = f.numbers;

  return {
    commit: n.callCommit ?? n.closed + n.commit,
    bestCase: n.callBestCase ?? n.closed + n.commit + n.bestCase,
    error: "",
    done: false,
    busy: false,
  };
}

function onDealChange(forecast: { value: RepForecast }, deal: DealRow) {
  deal.saving = true;
  deal.error = "";

  try {
    forecast.value = updateDeal(deal.id, deal.amount, deal.closeDate, deal.category);
  } catch (err: any) {
    deal.saving = false;
    deal.error = err.message;
    toast.error(err.message, { description: deal.account });
  }
}

function onCallSubmit(forecast: { value: RepForecast }, call: CallState) {
  call.busy = true;
  call.error = "";

  try {
    forecast.value = submitCall({ commit: call.commit, bestCase: call.bestCase });
    call.done = true;
  } catch (err: any) {
    call.error = err.message;
  }

  call.busy = false;
}

function flagFor(deal: Deal, quarterEnd: string): string {
  if (deal.closeDate > quarterEnd) {
    return "Pushed past quarter end";
  }

  if (deal.closeDate < todayISO()) {
    return "Close date has passed";
  }

  return "";
}

<html lang="en" class="page-deals" (
  name: string,
  initial: RepForecast,
  private forecast: { value: RepForecast } = { value: initial },
  private call: CallState = callDefaults(initial),
)>
  <head>
    <title>My forecast · commitvane</title>
    <meta name="description" content="Your deals and weekly call">
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <AppHeader {name} role="rep" current="deals" />
    <Toaster richColors />

    <main class="deals-main page-shell is-wide stack is-xl">
      <div class="forecast-head row">
        <div class="stack is-xs">
          <h1>{name.split(" ")[0]}'s forecast</h1>
          <p class="forecast-meta">{quarterLabel(forecast.value.quarter)} · quarter ends {dayLabel(forecast.value.quarterEnd)}</p>
        </div>
      </div>

      <ForecastStats numbers={forecast.value.numbers} />

      <div class="deals-layout">
        <div class="stack is-xl">
          <Card>
            <CardHeader>
              <CardTitle level={2}>Open deals</CardTitle>
              <CardDescription>{forecast.value.open.length} deals · changes save as you make them</CardDescription>
            </CardHeader>
            <CardContent>
              <Table label="Open deals" e:if={forecast.value.open.length > 0}>
                <table class="deals-table">
                  <thead>
                    <tr>
                      <TableHead>Account</TableHead>
                      <TableHead>Stage</TableHead>
                      <TableHead align="end">Amount</TableHead>
                      <TableHead>Close date</TableHead>
                      <TableHead>Category</TableHead>
                    </tr>
                  </thead>
                  <tbody>
                    <tr e:for={deal of forecast.value.open as DealRow[]}
                        class={["deal-row", deal.saving && "is-saving", deal.error && "is-error"]}>
                      <TableCell class="deal-cell-account">
                        <div class="deal-account">{deal.account}</div>
                        <div class="deal-name">{deal.name}</div>
                      </TableCell>
                      <TableCell>
                        {deal.stage} <span class="stage-prob">{deal.probability}%</span>
                      </TableCell>
                      <TableCell align="end">
                        <NumberInput class="deal-amount num-input"
                                     value={deal.amount}
                                     min={0}
                                     step={1000}
                                     largeStep={10000}
                                     size="sm"
                                     buttons="none"
                                     attrs={{ "aria-label": `Amount for ${deal.account}` }}
                                     onValueCommit={() => onDealChange(forecast, deal)} />
                      </TableCell>
                      <TableCell>
                        <DatePicker class="deal-date"
                                    value={deal.closeDate}
                                    size="sm"
                                    format={{ month: "short", day: "numeric", year: "numeric" }}
                                    label={`Close date for ${deal.account}`}
                                    onValueChange={() => onDealChange(forecast, deal)} />
                        <span e:if={flagFor(deal, forecast.value.quarterEnd)} class="deal-flag">
                          {flagFor(deal, forecast.value.quarterEnd)}
                        </span>
                      </TableCell>
                      <TableCell class="deal-cell-category">
                        <NativeSelect class="deal-category"
                                      value={deal.category}
                                      size="sm"
                                      options={CATEGORY_OPTIONS}
                                      attrs={{ "aria-label": `Forecast category for ${deal.account}` }}
                                      onchange={() => onDealChange(forecast, deal)} />
                      </TableCell>
                    </tr>
                  </tbody>
                </table>
              </Table>
              <Empty e:else level={3} description="No open deals. Everything this quarter is closed." />
            </CardContent>
          </Card>

          <Card>
            <CardHeader>
              <CardTitle level={2}>Closed this quarter</CardTitle>
              <CardDescription>{money(forecast.value.numbers.closed)}</CardDescription>
            </CardHeader>
            <CardContent>
              <Table label="Closed this quarter" e:if={forecast.value.closed.length > 0}>
                <table class="deals-table">
                  <thead>
                    <tr>
                      <TableHead>Account</TableHead>
                      <TableHead>Closed</TableHead>
                      <TableHead align="end">Amount</TableHead>
                      <TableHead>Category</TableHead>
                    </tr>
                  </thead>
                  <tbody>
                    <tr e:for={deal of forecast.value.closed as DealRow[]}
                        class={["deal-row", deal.saving && "is-saving", deal.error && "is-error"]}>
                      <TableCell class="deal-cell-account">
                        <div class="deal-account">{deal.account}</div>
                        <div class="deal-name">{deal.name}</div>
                      </TableCell>
                      <TableCell>{dayLabel(deal.closeDate)}</TableCell>
                      <TableCell align="end">{money(deal.amount)}</TableCell>
                      <TableCell class="deal-cell-category">
                        <NativeSelect class="deal-category"
                                      value={deal.category}
                                      size="sm"
                                      options={CATEGORY_OPTIONS}
                                      attrs={{ "aria-label": `Forecast category for ${deal.account}` }}
                                      onchange={() => onDealChange(forecast, deal)} />
                      </TableCell>
                    </tr>
                  </tbody>
                </table>
              </Table>
              <Empty e:else level={3} description="Nothing closed yet this quarter." />
            </CardContent>
          </Card>
        </div>

        <aside class="call-card">
          <Card>
            <CardContent>
              <form class="stack" onsubmit={() => onCallSubmit(forecast, call)}>
                <div class="stack is-xs">
                  <h2 class="section-title">Weekly call</h2>
                  <p class="muted text-sm" e:if={forecast.value.numbers.calledAt}>
                    Last called {whenLabel(forecast.value.numbers.calledAt!)}
                  </p>
                  <p class="muted text-sm" e:else>You haven't called {quarterLabel(forecast.value.quarter)} yet.</p>
                </div>

                <dl class="call-deals">
                  <dt>Deals: closed + commit</dt>
                  <dd>{money(forecast.value.numbers.closed + forecast.value.numbers.commit)}</dd>
                  <dt>Deals: + best case</dt>
                  <dd>{money(forecast.value.numbers.closed + forecast.value.numbers.commit + forecast.value.numbers.bestCase)}</dd>
                </dl>

                <Field label="Commit for the quarter">
                  <NumberInput value={call.commit}
                               min={0}
                               step={1000}
                               largeStep={10000}
                               buttons="none"
                               required
                               onValueChange={() => call.done = false} />
                </Field>

                <Field label="Best case for the quarter">
                  <NumberInput value={call.bestCase}
                               min={0}
                               step={1000}
                               largeStep={10000}
                               buttons="none"
                               required
                               onValueChange={() => call.done = false} />
                </Field>

                <Alert e:if={call.error} variant="danger" description={call.error} />
                <Alert e:if={call.done} variant="success" role="status" description="Call submitted. Your manager sees it now." />

                <Button type="submit" variant="primary" block loading={call.busy}>Submit call</Button>
              </form>
            </CardContent>
          </Card>
        </aside>
      </div>
    </main>
  </body>
</html>
