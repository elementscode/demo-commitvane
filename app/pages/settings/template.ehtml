import "./style.css";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import { AppHeader } from "#app/shared/templates/layout/template";
import { money, quarterLabel } from "#app/shared/format";
import { Card, CardHeader, CardTitle, CardDescription, CardAction, CardContent } from "@elements/ui/card";
import { Table, TableHead, TableCell } from "@elements/ui/table";
import { NativeSelect } from "@elements/ui/native-select";
import { NumberInput } from "@elements/ui/number-input";
import { Toaster, toast } from "@elements/ui/toast";
import { fetchSettings, setQuota, setProbability, Settings, QuotaRow, StageRow } from "./services";

function onQuotaChange(settings: { value: Settings }, row: QuotaRow) {
  try {
    setQuota(row.repId, settings.value.quarter, row.amount);
    row.amount = Number(row.amount);
    toast.success("Saved", { description: `${row.name}'s quota for ${quarterLabel(settings.value.quarter)}` });
  } catch (err: any) {
    toast.error(err.message, { description: row.name });
  }
}

function onProbabilityChange(stage: StageRow) {
  try {
    setProbability(stage.id, stage.probability);
    toast.success("Saved", { description: `${stage.name} probability` });
  } catch (err: any) {
    toast.error(err.message, { description: stage.name });
  }
}

function onQuarterChange(settings: { value: Settings }, quarter: string) {
  settings.value = fetchSettings(quarter);
}

function totalQuota(rows: QuotaRow[]): number {
  return rows.reduce((sum, r) => sum + (Number(r.amount) || 0), 0);
}

<html lang="en" class="page-settings" (
  name: string,
  initial: Settings,
  private settings: { value: Settings } = { value: initial },
  private picked: { quarter: string } = { quarter: initial.quarter },
)>
  <head>
    <title>Quotas &amp; stages · commitvane</title>
    <meta name="description" content="Quotas per rep and stage probabilities">
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <AppHeader {name} role="manager" current="settings" />
    <Toaster richColors />

    <main class="settings-main page-shell is-wide stack is-xl">
      <div class="forecast-head row">
        <div class="stack is-xs">
          <h1>Quotas &amp; stages</h1>
          <p class="forecast-meta">Changes save as you make them and show on the dashboard right away.</p>
        </div>
      </div>

      <div class="settings-grid">
        <Card>
          <CardHeader>
            <CardTitle level={2}>Quotas</CardTitle>
            <CardAction>
              <NativeSelect value={picked.quarter}
                            size="sm"
                            attrs={{ "aria-label": "Quarter" }}
                            options={settings.value.quarters.map((q) => ({ value: q, label: quarterLabel(q) }))}
                            onchange={() => onQuarterChange(settings, picked.quarter)} />
            </CardAction>
          </CardHeader>
          <CardContent>
            <Table label="Quotas">
              <table>
                <thead>
                  <tr>
                    <TableHead>Rep</TableHead>
                    <TableHead align="end">Quota for {quarterLabel(settings.value.quarter)}</TableHead>
                  </tr>
                </thead>
                <tbody>
                  <tr e:for={row of settings.value.quotas}>
                    <TableCell>{row.name}</TableCell>
                    <TableCell align="end">
                      <NumberInput class="settings-input num-input"
                                   value={row.amount}
                                   min={0}
                                   step={5000}
                                   largeStep={50000}
                                   size="sm"
                                   buttons="none"
                                   attrs={{ "aria-label": `Quota for ${row.name}` }}
                                   onValueCommit={() => onQuotaChange(settings, row)} />
                    </TableCell>
                  </tr>
                </tbody>
                <tfoot>
                  <tr>
                    <TableCell>Team</TableCell>
                    <TableCell align="end">{money(totalQuota(settings.value.quotas))}</TableCell>
                  </tr>
                </tfoot>
              </table>
            </Table>
          </CardContent>
        </Card>

        <Card>
          <CardHeader>
            <CardTitle level={2}>Stage probabilities</CardTitle>
            <CardDescription>Weighted forecast is amount × probability</CardDescription>
          </CardHeader>
          <CardContent>
            <Table label="Stage probabilities">
              <table>
                <thead>
                  <tr>
                    <TableHead>Stage</TableHead>
                    <TableHead align="end">Probability</TableHead>
                  </tr>
                </thead>
                <tbody>
                  <tr e:for={stage of settings.value.stages}>
                    <TableCell>{stage.name}</TableCell>
                    <TableCell align="end">
                      <NumberInput class="settings-input is-pct num-input"
                                   value={stage.probability}
                                   min={0}
                                   max={100}
                                   step={5}
                                   size="sm"
                                   buttons="none"
                                   attrs={{ "aria-label": `Probability for ${stage.name}` }}
                                   onValueCommit={() => onProbabilityChange(stage)} />
                    </TableCell>
                  </tr>
                </tbody>
              </table>
            </Table>
          </CardContent>
        </Card>
      </div>
    </main>
  </body>
</html>
