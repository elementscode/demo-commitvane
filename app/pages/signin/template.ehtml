import "./style.css";
import { redirect } from "@elements/app";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import { signin, homeFor, Role } from "#app/shared/services/auth";
import { BrandMark } from "#app/shared/templates/layout/template";
import { Card, CardContent } from "@elements/ui/card";
import { Field, FieldGroup } from "@elements/ui/field";
import { Input } from "@elements/ui/input";
import { Button } from "@elements/ui/button";
import { Alert } from "@elements/ui/alert";
import { ItemGroup, Item } from "@elements/ui/item";

export interface DemoLogin {
  id: string;
  name: string;
  email: string;
  role: Role;
}

interface SigninForm {
  email: string;
  password: string;
  error: string;
  busy: boolean;
}

export const DEMO_PASSWORD = "forecast";

function onSubmit(form: SigninForm) {
  form.busy = true;

  try {
    let role = signin(form.email, form.password);
    form.error = "";
    redirect(homeFor(role));
  } catch (err: any) {
    form.error = err.message;
    form.busy = false;
  }
}

function onPick(form: SigninForm, login: DemoLogin) {
  form.email = login.email;
  form.password = DEMO_PASSWORD;
  onSubmit(form);
}

<html lang="en" class="page-signin" (
  logins: DemoLogin[],
  private form: SigninForm = { email: "", password: "", error: "", busy: false },
)>
  <head>
    <title>Sign in · commitvane</title>
    <meta name="description" content="Sales forecasting for the team">
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <main class="signin-main">
      <div class="signin-grid">
        <Card>
          <CardContent>
            <form class="stack is-lg" onsubmit={() => onSubmit(form)}>
              <div class="stack is-xs">
                <div class="signin-brand row">
                  <BrandMark />
                  commitvane
                </div>
                <p class="signin-lede">The weekly call, and what the deals say.</p>
              </div>

              <Alert e:if={form.error} variant="danger" description={form.error} />

              <FieldGroup>
                <Field label="Email">
                  <Input type="email"
                         name="email"
                         value={form.email}
                         placeholder="you@company.com"
                         required
                         attrs={{ autocomplete: "email", autocapitalize: "none", spellcheck: "false" }} />
                </Field>

                <Field label="Password">
                  <Input type="password"
                         name="password"
                         value={form.password}
                         required
                         attrs={{ autocomplete: "current-password" }} />
                </Field>
              </FieldGroup>

              <Button type="submit" variant="primary" block loading={form.busy}>Sign in</Button>
            </form>
          </CardContent>
        </Card>

        <Card class="demo-logins" e:if={logins.length > 0}>
          <CardContent class="stack">
            <div class="stack is-xs">
              <h2>Demo logins</h2>
              <p class="signin-lede">Every account's password is <code>{DEMO_PASSWORD}</code>. Pick one to sign in.</p>
            </div>

            <p class="demo-group">Managers</p>
            <ItemGroup label="Managers" class="demo-list">
              <Item e:for={login of logins.filter((l) => l.role === "manager")}
                    variant="outline"
                    size="xs"
                    title={login.name}
                    description={login.email}
                    onclick={() => onPick(form, login)} />
            </ItemGroup>

            <p class="demo-group">Reps</p>
            <ItemGroup label="Reps" class="demo-list">
              <Item e:for={login of logins.filter((l) => l.role === "rep")}
                    variant="outline"
                    size="xs"
                    title={login.name}
                    description={login.email}
                    onclick={() => onPick(form, login)} />
            </ItemGroup>
          </CardContent>
        </Card>
      </div>
    </main>
  </body>
</html>
